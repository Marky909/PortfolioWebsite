@model PortfolioWebsite.Models.ContactForm

@{
    ViewData["Title"] = "Message Details";
}

<div class="container py-5">

    <div class="d-flex justify-content-between align-items-center mb-4">
        <h2>Message Details</h2>

        <a asp-action="Index"
           class="btn btn-outline-dark">
            Back to Messages
        </a>
    </div>

    <div class="card shadow-sm">

        <div class="card-body">

            <div class="mb-3">
                <strong>Name:</strong>
                <p>@Model.Name</p>
            </div>

            <div class="mb-3">
                <strong>Email:</strong>
                <p>
                    <a href="mailto:@Model.Email">
                        @Model.Email
                    </a>
                </p>
            </div>

            <div class="mb-3">
                <strong>Sent:</strong>
                <p>@Model.CreatedAt.ToLocalTime()</p>
            </div>

            <div class="mb-3">
                <strong>Message:</strong>

                <div class="border rounded p-3 mt-2">
                    @Model.Message
                </div>
            </div>

        </div>

    </div>

</div>