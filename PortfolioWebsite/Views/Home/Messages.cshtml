@model IEnumerable<PortfolioWebsite.Models.ContactForm>

@{
    ViewData["Title"] = "Inbox - Messages";
}

<div class="container py-5">
    <div class="d-flex justify-content-between align-items-center mb-4">
        <div>
            <h2>Inbox</h2>
            <p class="text-muted mb-0">Messages submitted through your portfolio contact form.</p>
        </div>
        <span class="badge bg-dark fs-6">Total: @Model.Count()</span>
    </div>

    @if (!Model.Any())
    {
        <div class="alert alert-secondary text-center py-4">
            <h5>No messages yet!</h5>
            <p class="text-muted mb-0">Submissions from your portfolio will appear here.</p>
        </div>
    }
    else
    {
        <div class="row g-3">
            @foreach (var msg in Model)
            {
                <div class="col-12">
                    <div class="card shadow-sm border-0">
                        <div class="card-body">
                            <div class="d-flex justify-content-between align-items-start">
                                <div>
                                    <h5 class="card-title mb-1">@msg.Name</h5>
                                    <a href="mailto:@msg.Email" class="text-decoration-none text-muted small">
                                        ✉️ @msg.Email
                                    </a>
                                </div>
                                <span class="badge bg-light text-secondary border">
                                    @msg.CreatedAt.ToString("MMM dd, yyyy - hh:mm tt")
                                </span>
                            </div>
                            <hr class="my-3" />
                            <p class="card-text mb-0" style="white-space: pre-line;">
                                @msg.Message
                            </p>
                        </div>
                    </div>
                </div>
            }
        </div>
    }
</div>